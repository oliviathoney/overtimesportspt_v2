---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  className?: string;
  position?: string;
  priority?: boolean;
}

const { src, alt, className = "", position = "center", priority = false } = Astro.props;
const width = Math.min(src.width, 1600);
const widths = [...new Set([400, 800, 1200, width])].filter((size) => size <= width).sort((a, b) => a - b);
---

<Image
  src={src}
  alt={alt}
  class:list={["program-photo", className]}
  style={{ objectPosition: position }}
  width={width}
  widths={widths}
  sizes="(min-width: 1200px) 560px, (min-width: 900px) 50vw, calc(100vw - 40px)"
  format="webp"
  quality={85}
  loading={priority ? "eager" : "lazy"}
  fetchpriority={priority ? "high" : "auto"}
  decoding="async"
/>
