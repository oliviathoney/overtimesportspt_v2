---
export interface ProgramPhase {
  stage: string;
  title: string;
  description: string;
  items?: string[];
}

interface Props {
  eyebrow: string;
  heading: string;
  phases: ProgramPhase[];
}

const { eyebrow, heading, phases } = Astro.props;
---

<section class="program-section program-section--surface" id="roadmap" aria-labelledby="roadmap-heading">
  <div class="program-container">
    <header class="program-section__intro">
      <p class="block-subtitle">{eyebrow}</p>
      <h2 id="roadmap-heading">{heading}</h2>
      <p>A progressive benchmark approach &mdash; each phase is earned, not forced.</p>
      <p>Each phase builds the foundation for the next: measured, intentional, and never rushed.</p>
    </header>
    <ol class="program-roadmap">
      {phases.map((phase, index) => (
        <li class="program-phase">
          <div class="program-phase__top">
            <span class="program-phase__number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <p class="program-phase__stage">{phase.stage}</p>
          </div>
          <h3>{phase.title}</h3>
          <p>{phase.description}</p>
          {phase.items && <ul>{phase.items.map((item) => <li>{item}</li>)}</ul>}
        </li>
      ))}
    </ol>
  </div>
</section>
