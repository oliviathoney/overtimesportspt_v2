---
import { Image } from "astro:assets";
import oneOnOne from "../assets/images/services/PT.jpg";
import testing from "../assets/images/services/Force Plates.jpg";
import treatment from "../assets/images/services/Manipulation.jpg";
import education from "../assets/images/services/Education.jpg";

const points = [
  {
    title: "60 minutes, one-on-one.",
    description: "Every session is with a Doctor of Physical Therapy. You're never handed off to an aide or assistant.",
    icon: "M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0ZM12 6v6l4 2",
    image: oneOnOne,
    alt: "An Overtime physical therapist working one-on-one with an athlete on a knee exercise.",
  },
  {
    title: "Assessing, not guessing.",
    description: "VALD force plates, strength dynamometry testing, and running gait analysis show where you are and when you are ready.",
    icon: "M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0ZM17 12a5 5 0 1 1-10 0 5 5 0 0 1 10 0ZM13 12a1 1 0 1 1-2 0 1 1 0 0 1 2 0Z",
    image: testing,
    alt: "An athlete jumping over force plates while an Overtime physical therapist observes.",
  },
  {
    title: "Treatment on day one.",
    description: "Your first visit includes a thorough evaluation, hands-on treatment, and exercises to create the adaptations needed to return to your passion.",
    icon: "M9 4H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-3M9 2h6v4H9V2ZM8 12h8M8 16h6",
    image: treatment,
    alt: "An Overtime physical therapist providing hands-on treatment to a patient on a treatment table.",
  },
  {
    title: "No referral needed.",
    description: "Colorado lets you see a physical therapist directly.",
    icon: "M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0ZM7.5 12l3 3 6-6",
    image: education,
    alt: "A physical therapist explaining anatomy to a patient using a phone.",
  },
];
---

<section class="home-difference" aria-labelledby="difference-heading">
  <div class="home-difference__inner">
    <div class="home-difference__intro">
      <h2 id="difference-heading">What's different here.</h2>
      <p>
        Most clinics estimate when you are ready. We test it using objective
        data from equipment used by pro teams. Every session is one-on-one
        with a Doctor of Physical Therapy and tailored to you.
      </p>
    </div>
    <div class="home-difference__story">
      <ul class="home-difference__list">
        {points.map((point, index) => (
          <li class="home-difference__item" data-point={index}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d={point.icon} />
            </svg>
            <div>
              <h3>{point.title}</h3>
              <p>{point.description}</p>
            </div>
          </li>
        ))}
      </ul>
      <div class="home-difference__panel">
        <div class="home-difference__photos">
          {points.map((point, index) => (
            <figure
              class:list={[
                "home-difference__photo",
                { "home-difference__photo--default": index === 1 },
              ]}
              data-photo={index}
              aria-hidden={index !== 1}
            >
              <Image
                class="home-difference__image"
                src={point.image}
                alt={point.alt}
                widths={[520, 1040]}
                sizes="(min-width: 1024px) 520px, (min-width: 640px) 520px, 92vw"
                width={1040}
                quality={90}
                loading="lazy"
                decoding="async"
              />
              <figcaption class="home-difference__caption">
                <span aria-hidden="true">0{index + 1}</span>
                {point.title}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>(".home-difference");

  if (section) {
    const items = section.querySelectorAll<HTMLElement>("[data-point]");
    const photos = section.querySelectorAll<HTMLElement>("[data-photo]");
    const motion = window.matchMedia(
      "(min-width: 1024px) and (prefers-reduced-motion: no-preference)",
    );
    let frame: number | undefined;

    const showPhoto = (index: string) => {
      items.forEach((item) => {
        item.dataset.active = String(motion.matches && item.dataset.point === index);
      });
      photos.forEach((photo) => {
        const active = photo.dataset.photo === index;
        photo.dataset.active = String(active);
        photo.setAttribute("aria-hidden", String(!active));
      });
    };

    const updatePhoto = () => {
      frame = undefined;
      let closest = Infinity;
      let active = "0";

      items.forEach((item) => {
        const bounds = item.getBoundingClientRect();
        const distance = Math.abs(
          bounds.top + bounds.height / 2 - window.innerHeight / 2,
        );
        if (distance < closest && item.dataset.point !== undefined) {
          closest = distance;
          active = item.dataset.point;
        }
      });
      showPhoto(active);
    };

    const scheduleUpdate = () => {
      if (motion.matches && frame === undefined) {
        frame = window.requestAnimationFrame(updatePhoto);
      }
    };

    const updateMotion = () => {
      if (frame !== undefined) {
        window.cancelAnimationFrame(frame);
        frame = undefined;
      }
      section.classList.toggle("is-animated", motion.matches);
      if (motion.matches) {
        scheduleUpdate();
      } else {
        showPhoto("1");
      }
    };

    updateMotion();
    motion.addEventListener("change", updateMotion);
    window.addEventListener("resize", updateMotion);
    window.addEventListener("scroll", scheduleUpdate, { passive: true });
  }
</script>

<style>
  .home-difference {
    padding-block: clamp(40px, 5vw, 64px);
    background: theme("colors.bgNight");
    color: theme("colors.primaryText");
  }

  .home-difference__inner {
    width: min(1136px, calc(100% - 40px));
    margin-inline: auto;
  }

  .home-difference__intro {
    max-width: 760px;
    margin-bottom: 32px;
  }

  h2 {
    margin-bottom: 18px;
    font-size: clamp(2rem, 3vw, 2.75rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.035em;
  }

  p {
    color: theme("colors.secondaryText");
    line-height: 1.5;
  }

  .home-difference__intro p {
    font-size: 18px;
  }

  .home-difference__story {
    display: grid;
    gap: 32px;
  }

  .home-difference__list {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .home-difference__item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .home-difference__item svg {
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    fill: none;
    stroke: theme("colors.secondaryColor");
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  h3 {
    margin-bottom: 4px;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.4;
  }

  .home-difference__panel {
    min-width: 0;
  }

  .home-difference__photos {
    position: relative;
    width: min(100%, 520px);
    aspect-ratio: 1;
    margin-inline: auto;
    overflow: hidden;
    border-radius: 12px;
  }

  .home-difference__photo {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
  }

  .home-difference__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .home-difference__caption {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 48px 20px 20px;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.85));
    color: white;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.4;
  }

  .home-difference__caption span {
    color: theme("colors.secondaryColor");
    font-size: 14px;
  }

  .home-difference__photo--default {
    opacity: 1;
  }

  @media (min-width: 768px) {
    .home-difference__inner {
      width: min(1136px, calc(100% - 64px));
    }
  }

  @media (min-width: 900px) {
    .home-difference__story {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: center;
      gap: 48px;
    }

    .home-difference__panel {
      order: -1;
    }
  }

  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .is-animated .home-difference__story {
      align-items: start;
      gap: 72px;
    }

    .is-animated .home-difference__list {
      gap: 0;
      padding-bottom: max(30svh, 280px);
    }

    .is-animated .home-difference__item {
      flex-direction: column;
      justify-content: center;
      gap: 10px;
      min-height: 24svh;
      padding: 20px 18px;
      border-left: 3px solid transparent;
      border-radius: 0 12px 12px 0;
      transition: background-color 0.25s ease, border-color 0.25s ease;
    }

    .is-animated .home-difference__item h3 {
      transition: color 0.25s ease;
    }

    .is-animated .home-difference__item[data-active="true"] {
      border-left-color: theme("colors.secondaryColor");
      background-color: rgba(117, 174, 120, 0.08);
    }

    .is-animated .home-difference__item[data-active="true"] h3 {
      color: theme("colors.secondaryColor");
    }

    .is-animated .home-difference__panel {
      align-self: stretch;
    }

    .is-animated .home-difference__photos {
      position: sticky;
      top: 128px;
      width: min(100%, 520px, calc(100svh - 192px));
    }

    .is-animated .home-difference__photo {
      opacity: 0;
      transition: opacity 0.4s ease;
    }

    .is-animated .home-difference__photo[data-active="true"] {
      opacity: 1;
    }
  }
</style>
