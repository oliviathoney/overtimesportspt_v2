---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import Layout from "./Layout.astro";
import { Navbar } from "../components/Navbar.jsx";
import { Footer } from "../components/Footer.jsx";
import { AboutConsultation } from "../components/AboutConsultation.jsx";
import { ProgramConsultationButton } from "../components/ProgramConsultationButton.jsx";
import ProgramPhoto from "../components/ProgramPhoto.astro";
import SiteData from "../constants/siteData.json";
import "../styles/Theme.css";
import "../styles/custom.css";
import "../styles/Programs.css";

interface Props {
  title: string;
  description: string;
  programKey: "acl" | "running";
  programName: string;
  specialty: string;
  headline: string;
  accent: string;
  lead: string;
  introduction: string;
  heroImage: ImageMetadata;
  heroAlt: string;
  heroPosition?: string;
  proof: string[];
  ctaLabel: string;
  closingHeading: string;
  closingDescription: string;
}

const {
  title, description, programKey, programName, specialty, headline, accent,
  lead, introduction, heroImage, heroAlt, heroPosition = "center",
  proof, ctaLabel, closingHeading, closingDescription,
} = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, "/"), Astro.site);
const socialImage = await getImage({ src: heroImage, width: 1200, height: 630, fit: "cover", format: "webp" });
const previewImage = new URL(socialImage.src, Astro.url.origin).href;
---

<Layout
  title={title}
  seo={{
    title,
    description,
    canonical,
    openGraph: {
      basic: { title, type: "website", image: previewImage, url: canonical },
      optional: { description, siteName: SiteData.default.name },
    },
    twitter: {
      card: "summary_large_image", title, description, image: previewImage,
      creator: SiteData.default.twitter.creator,
    },
  }}
>
  <Navbar client:load />
  <div class="program-page">
    <section class="program-hero" aria-labelledby="program-heading">
      <div class="program-container program-hero__inner">
        <div class="program-hero__content">
          <p class="block-subtitle">{specialty}</p>
          <p class="program-hero__name">{programName}</p>
          <h1 id="program-heading">{headline} <span>{accent}</span></h1>
          <p class="program-hero__lead">{lead}</p>
          <p class="program-hero__description">{introduction}</p>
          <div class="program-actions">
            <ProgramConsultationButton label={ctaLabel} source={`${programKey}_hero`} client:load />
            <a class="program-text-link" href="#roadmap">Explore the roadmap <span aria-hidden="true">&darr;</span></a>
          </div>
          <p class="program-hero__note">Start with a free, 15-minute phone consultation.</p>
        </div>
      </div>
      <div class="program-hero__photo">
        <ProgramPhoto src={heroImage} alt={heroAlt} priority position={heroPosition} sizes="(min-width: 1024px) 65vw, 100vw" />
      </div>
    </section>
    <div class="program-proof">
      <ul class="program-container" aria-label="Program highlights">
        {proof.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    <slot />
    <AboutConsultation
      heading={closingHeading}
      description={closingDescription}
      buttonText={ctaLabel}
      source={`${programKey}_closing`}
      headingId="program-consultation-heading"
      client:load
    />
  </div>
  <Footer />
</Layout>
