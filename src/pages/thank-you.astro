---
import Layout from "../layouts/Layout.astro";
import { Navbar } from "../components/Navbar.jsx";
import { Footer } from "../components/Footer.jsx";
import "../styles/Theme.css";
import "../styles/custom.css";
---

<Layout
  title="Thank You | OVERTIME Sports PT"
  seo={{
    title: "Thank You | OVERTIME Sports PT",
    description: "What happens next after requesting a consultation with Overtime Sports PT.",
    noindex: true,
    nofollow: true,
  }}
>
  <Navbar client:load />
  <section class="consultation-thanks" aria-labelledby="thanks-heading">
    <div class="consultation-thanks__inner">
      <p class="block-subtitle">Your next step</p>
      <h1 id="thanks-heading">Thanks&mdash;your consultation request is in.</h1>
      <p>Our team will contact you to arrange your free, 15-minute phone consultation with a Sports PT.</p>
      <p>We'll talk about your goals and how we can help, then discuss scheduling an initial evaluation. Your appointment is not booked yet.</p>
      <a class="contained-button" href="/">BACK TO HOME</a>
    </div>
  </section>
  <Footer />
</Layout>

<style>
  .consultation-thanks {
    min-height: 75svh;
    padding: 180px 24px 80px;
    background: rgb(var(--surface-night));
  }

  .consultation-thanks__inner {
    max-width: 720px;
    margin-inline: auto;
  }

  h1 {
    margin-block: 16px 24px;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.035em;
  }

  .consultation-thanks__inner > p:not(.block-subtitle) {
    margin-bottom: 20px;
    color: rgb(var(--text-muted));
    line-height: 1.7;
  }

  .consultation-thanks a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    margin-top: 12px;
    padding: 14px 24px;
  }
</style>
