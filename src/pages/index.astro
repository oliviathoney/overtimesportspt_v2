---
import Layout from "../layouts/Layout.astro";
import { Hero } from "../components/Hero.jsx";
import { Navbar } from "../components/Navbar.jsx";
import { Introduction } from "../components/Introduction.jsx";
import Difference from "../components/Difference.astro";
import { Testimonials } from "../components/Testimonials.jsx";
import { GetStarted } from "../components/GetStarted";
import { SignOff } from "../components/SignOff";
import { Footer } from "../components/Footer.jsx";
import "../styles/Theme.css";
import "../styles/Diagonals.css";
import "../styles/custom.css";
import SiteData from "../constants/siteData.json";
---

<Layout title="OVERTIME Sports">
  <Navbar hero client:load />
  <Hero client:load />
  <section class="home-proof" aria-label="Why patients choose Overtime">
    <ul class="home-proof__list">
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 20V10m8 10V4m8 16v-7" />
        </svg>
        <span>Objective Data Testing</span>
      </li>
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m12 2 8 4v6c0 5-8 10-8 10S4 17 4 12V6l8-4Z" />
          <path d="m8.5 11.5 2.5 2.5 4.5-5" />
        </svg>
        <span>A Doctor of PT every visit</span>
      </li>
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="9" />
          <path d="M12 6v6l4 2" />
        </svg>
        <span>60-minute one-on-one sessions</span>
      </li>
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="9" />
          <path d="m7.5 12 3 3 6-6" />
        </svg>
        <span>No referral needed</span>
      </li>
    </ul>
  </section>
  <Introduction client:load />
  <Difference />
  <GetStarted client:load />
  <Testimonials client:load />
  <SignOff client:load />
  <Footer />
</Layout>
